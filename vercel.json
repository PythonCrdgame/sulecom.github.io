{
  "version": 2,
  "builds": [
    { "src": "api/[...path].js", "use": "@vercel/node" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/api(?:/.*)?$", "dest": "/api/[...path]" },
    { "src": "^/signup/?$", "dest": "/frontend/signup.html" },
    { "src": "^/signin/?$", "dest": "/frontend/signin.html" },
    { "src": "^/home/?$", "dest": "/frontend/home.html" },
    { "src": "^/seller/?$", "dest": "/frontend/seller.html" },
    { "src": "^/checkout/?$", "dest": "/frontend/checkout.html" },
    { "src": "^/cart/?$", "dest": "/frontend/checkout.html" },
    { "src": "^/(.*)$", "dest": "/frontend/$1" }
  ]
}
